{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hair-quiz",
  "compatibility_date": "2026-08-17",
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  }
}
