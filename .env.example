# Copy to .env and fill in.

# --- Firebase (quiz insights + admin login) ---
# From Firebase Console → Project settings → Your apps → Web app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# --- Previous Firebase (optional; npm run migrate:firestore) ---
SOURCE_FIREBASE_API_KEY=
SOURCE_FIREBASE_AUTH_DOMAIN=
SOURCE_FIREBASE_PROJECT_ID=
SOURCE_FIREBASE_STORAGE_BUCKET=
SOURCE_FIREBASE_MESSAGING_SENDER_ID=
SOURCE_FIREBASE_APP_ID=

# --- Consultation notify via Google Apps Script (Sheet + Gmail) ---
# See scripts/GOOGLE_APPS_SCRIPT_SETUP.md
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
GOOGLE_APPS_SCRIPT_SECRET=change-me

# --- Consultation emails (optional fallback; local `npm run dev` only) ---
# Used only if GOOGLE_APPS_SCRIPT_URL is not set.
BOOKING_TO_EMAIL=you@example.com

# SMTP (Gmail example: smtp.gmail.com + App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@example.com
SMTP_PASS=your-app-password
SMTP_FROM="Customised Haircare <you@example.com>"
