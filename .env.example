# Copy to .env and fill in to enable appointment emails

# Where staff notifications go
BOOKING_TO_EMAIL=you@example.com

# SMTP (Gmail example: smtp.gmail.com + App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@example.com
SMTP_PASS=your-app-password
SMTP_FROM="Live Love Locks <you@example.com>"
