# Copy to .env and fill in.

# --- Firebase (quiz insights + admin login) ---
# From Firebase Console → Project settings → Your apps → Web app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Consultation emails (optional) ---
# Where staff notifications go
BOOKING_TO_EMAIL=you@example.com

# SMTP (Gmail example: smtp.gmail.com + App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@example.com
SMTP_PASS=your-app-password
SMTP_FROM="Customised Haircare <you@example.com>"
